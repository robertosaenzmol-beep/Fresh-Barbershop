rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isStaff()  { return signedIn() && request.auth.token.email == 'barberia@freshbarbershop.es'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ID = <userId>_<YYYY-MM-DD>  → máximo 1 visita por cliente y día
    match /visits/{visitId} {
      allow read:   if isStaff() || isOwner(resource.data.userId);
      allow create: if isStaff()
                    && visitId.matches(request.resource.data.userId + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow delete: if isOwner(resource.data.userId);
      allow update: if false;
    }

    match /visitTokens/{tokenId} {
      allow create: if isOwner(request.resource.data.userId);
      allow get:    if isStaff() || isOwner(resource.data.userId);
      allow list:   if isOwner(resource.data.userId);
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt', 'usedBy'])
                    && resource.data.used == false;
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
