---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <!-- Primary -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type"        content={articleDate ? 'article' : 'website'} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImageURL} />
  <meta property="og:locale"      content="es_ES" />
  <meta property="og:site_name"   content="Fresh Barbershop" />
  {articleDate && <meta property="article:published_time" content={articleDate} />}
  {articleDate && <meta property="article:modified_time" content={articleDate} />}
  {articleDate && <meta property="article:author" content="Fresh Barbershop" />}
  {articleCategory && <meta property="article:section" content={articleCategory} />}

  <!-- Twitter / X -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/images/favicon.webp" />

  <!-- LCP preload -->
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- SEO: author, geo, hreflang -->
  <meta name="author" content="Fresh Barbershop" />
  <meta name="geo.region" content="ES-MD" />
  <meta name="geo.placename" content="Alcobendas" />
  <meta name="geo.position" content="40.5421482;-3.6332860" />
  <meta name="ICBM" content="40.5421482, -3.6332860" />
  <link rel="alternate" hreflang="es" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />

  <!-- Fonts (non-render-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" /></noscript>

  <!-- JSON-LD Local Business -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- GA stub: queues events (onclick handlers) until user consents and loadGA() fires -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
  </script>

</head>
<body>

  <!-- NAV ================================================== -->
  <nav class="nav" aria-label="Navegación principal">
    <a href="/">
      <img src="/images/logo-fresh-barbershop.webp" alt="Fresh Barbershop" class="nav-logo" width="800" height="451" />
    </a>
    <span class="nav-location">Alcobendas · Madrid</span>
    <a href={BOOKSY} target="_blank" rel="noopener nofollow" class="btn-ghost btn-ghost--light" onclick="gtag('event', 'reserva_booksy', { 'metodo': 'boton_web' })">
      Reservar →
    </a>
  </nav>

  <slot />

  <!-- FOOTER =============================================== -->
  <footer class="footer">
    <span class="footer-brand">Fresh Barbershop · Alcobendas · Madrid</span>
    <div class="footer-links">
      <a href={BOOKSY} class="footer-link" target="_blank" rel="noopener nofollow" onclick="gtag('event', 'reserva_booksy', { 'metodo': 'boton_web' })">Booksy</a>
      <a href="https://www.instagram.com/freshbarbershop_mad/" class="footer-link" target="_blank" rel="noopener nofollow">Instagram</a>
      <a href="https://www.instagram.com/saimonguedez_19" class="footer-link" target="_blank" rel="noopener nofollow">Simón</a>
      <a href="tel:+34642701740" class="footer-link" onclick="gtag('event', 'llamada_telefono', { 'metodo': 'footer' })">642 70 17 40</a>
    </div>
    <div class="footer-legal">
      <a href="/aviso-legal" class="footer-link footer-link--legal">Aviso legal</a>
      <a href="/politica-de-privacidad" class="footer-link footer-link--legal">Privacidad</a>
      <a href="/politica-de-cookies" class="footer-link footer-link--legal">Cookies</a>
    </div>
    <span class="footer-copy">© 2026 Fresh Barbershop Madrid</span>
  </footer>

  <!-- COOKIE BANNER ======================================== -->
  <div class="cookie-banner" id="cookie-banner" hidden role="dialog" aria-label="Aviso de cookies">
    <p class="cookie-text">
      Usamos cookies propias y de terceros (Google Analytics) para mejorar tu experiencia y analizar el tráfico de la web.
      <a href="/politica-de-cookies" class="cookie-link">Más información</a>
    </p>
    <div class="cookie-actions">
      <button class="cookie-btn cookie-btn--reject" id="cookie-reject">Rechazar no esenciales</button>
      <button class="cookie-btn cookie-btn--accept" id="cookie-accept">Aceptar todas</button>
    </div>
  </div>

  <script>
    (function () {
      /* ── Scroll reveal ── */
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal, .reveal-group').forEach((el) => {
        io.observe(el);
      });

      /* ── Cookie banner ── */
      const GA_ID = 'G-51880QYVXE';
      const STORAGE_KEY = 'cookies_accepted';

      function loadGA() {
        const s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        s.async = true;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', GA_ID);
      }

      const stored = localStorage.getItem(STORAGE_KEY);

      if (stored === null) {
        document.getElementById('cookie-banner').removeAttribute('hidden');
      } else if (stored === 'true') {
        loadGA();
      }

      document.getElementById('cookie-accept').addEventListener('click', function () {
        localStorage.setItem(STORAGE_KEY, 'true');
        document.getElementById('cookie-banner').setAttribute('hidden', '');
        loadGA();
      });

      document.getElementById('cookie-reject').addEventListener('click', function () {
        localStorage.setItem(STORAGE_KEY, 'false');
        document.getElementById('cookie-banner').setAttribute('hidden', '');
      });
    }());
  </script>

</body>
</html>
