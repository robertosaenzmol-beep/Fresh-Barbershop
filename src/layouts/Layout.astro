---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'Fresh Barbershop — Barbería en Alcobendas, Madrid',
  description = 'Barbería en Alcobendas, Madrid. Cortes, degradados, fade y arreglo de barba. Profesionales con criterio. Reserva en Booksy o llama al 642 70 17 40.',
  ogImage = '/hero-dani.jpeg',
  canonical,
} = Astro.props;

const BOOKSY = 'https://booksy.com/es-es/127272_fresh-barber-shop-madrid_barberia_52925_alcobendas#ba_s=seo';
const SITE = 'https://fresh-barbershop.vercel.app';
const canonicalURL = canonical ? `${SITE}${canonical}` : `${SITE}${Astro.url.pathname}`;
const ogImageURL = `${SITE}${ogImage}`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: 'Fresh Barbershop',
  alternateName: 'Fresh Barber Shop Madrid',
  description: 'Barbería en Alcobendas, Madrid. Cortes, degradados, fade y arreglo de barba.',
  url: SITE,
  telephone: '+34642701740',
  image: ogImageURL,
  priceRange: '€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'C. de la Marquesa Viuda de Aldama, 40',
    addressLocality: 'Alcobendas',
    addressRegion: 'Madrid',
    postalCode: '28100',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 40.5421482,
    longitude: -3.6332860,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],
      opens: '10:00',
      closes: '20:30',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '51',
    bestRating: '5',
  },
  sameAs: [
    'https://www.instagram.com/freshbarbershop_mad/',
    'https://booksy.com/es-es/127272_fresh-barber-shop-madrid_barberia_52925_alcobendas',
  ],
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImageURL} />
  <meta property="og:locale"      content="es_ES" />
  <meta property="og:site_name"   content="Fresh Barbershop" />

  <!-- Twitter / X -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- JSON-LD Local Business -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
</head>
<body>

  <!-- NAV ================================================== -->
  <nav class="nav">
    <a href="/">
      <img src="/logo-fresh-barbershop.png" alt="Fresh Barbershop" class="nav-logo" />
    </a>
    <span class="nav-location">Alcobendas · Madrid</span>
    <a href={BOOKSY} target="_blank" rel="noopener" class="btn-ghost btn-ghost--light">
      Reservar →
    </a>
  </nav>

  <slot />

  <!-- FOOTER =============================================== -->
  <footer class="footer">
    <span class="footer-brand">Fresh Barbershop · Alcobendas · Madrid</span>
    <div class="footer-links">
      <a href={BOOKSY} class="footer-link" target="_blank" rel="noopener">Booksy</a>
      <a href="https://www.instagram.com/freshbarbershop_mad/" class="footer-link" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.instagram.com/saimonguedez_19" class="footer-link" target="_blank" rel="noopener">Simón</a>
      <a href="tel:+34642701740" class="footer-link">642 70 17 40</a>
    </div>
    <div class="footer-legal">
      <a href="/aviso-legal" class="footer-link footer-link--legal">Aviso legal</a>
      <a href="/politica-de-privacidad" class="footer-link footer-link--legal">Privacidad</a>
      <a href="/politica-de-cookies" class="footer-link footer-link--legal">Cookies</a>
    </div>
    <span class="footer-copy">© 2026</span>
  </footer>

  <!-- COOKIE BANNER ======================================== -->
  <div class="cookie-banner" id="cookie-banner" hidden role="dialog" aria-label="Aviso de cookies">
    <p class="cookie-text">
      Usamos cookies propias y de terceros (Google Analytics) para mejorar tu experiencia y analizar el tráfico de la web.
      <a href="/politica-de-cookies" class="cookie-link">Más información</a>
    </p>
    <div class="cookie-actions">
      <button class="cookie-btn cookie-btn--reject" id="cookie-reject">Rechazar no esenciales</button>
      <button class="cookie-btn cookie-btn--accept" id="cookie-accept">Aceptar todas</button>
    </div>
  </div>

  <script>
    (function () {
      /* ── Scroll reveal ── */
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal, .reveal-group').forEach((el) => {
        io.observe(el);
      });

      /* ── Cookie banner ── */
      const GA_ID = 'G-XXXXXXXXXX';
      const STORAGE_KEY = 'cookies_accepted';

      function loadGA() {
        const s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        s.async = true;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA_ID);
      }

      const stored = localStorage.getItem(STORAGE_KEY);

      if (stored === null) {
        document.getElementById('cookie-banner').removeAttribute('hidden');
      } else if (stored === 'true') {
        loadGA();
      }

      document.getElementById('cookie-accept').addEventListener('click', function () {
        localStorage.setItem(STORAGE_KEY, 'true');
        document.getElementById('cookie-banner').setAttribute('hidden', '');
        loadGA();
      });

      document.getElementById('cookie-reject').addEventListener('click', function () {
        localStorage.setItem(STORAGE_KEY, 'false');
        document.getElementById('cookie-banner').setAttribute('hidden', '');
      });
    }());
  </script>

</body>
</html>
