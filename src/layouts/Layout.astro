---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  preloadImage?: string;
  articleDate?: string;
  articleCategory?: string;
  noindex?: boolean;
}

const {
  title = 'Fresh Barbershop — Barbería en Alcobendas, Madrid',
  description = 'Barbería en Alcobendas, Madrid. Cortes, degradados, fade y arreglo de barba. Profesionales con criterio. Reserva en Booksy o llama al 642 70 17 40.',
  ogImage = '/images/hero-dani.jpeg',
  canonical,
  preloadImage,
  articleDate,
  articleCategory,
  noindex = false,
} = Astro.props;

const BOOKSY = 'https://booksy.com/es-es/127272_fresh-barber-shop-madrid_barberia_52925_alcobendas#ba_s=seo';
const SITE = 'https://freshbarbershop.es';
const canonicalURL = canonical ? `${SITE}${canonical}` : `${SITE}${Astro.url.pathname}`;
const ogImageURL = `${SITE}${ogImage}`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: 'Fresh Barbershop',
  alternateName: 'Fresh Barber Shop Madrid',
  description: 'Barbería en Alcobendas, Madrid. Cortes, degradados, fade y arreglo de barba.',
  url: SITE,
  telephone: '+34642701740',
  email: 'freshbarbershop15@gmail.com',
  image: ogImageURL,
  priceRange: '€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'C. de la Marquesa Viuda de Aldama, 40',
    addressLocality: 'Alcobendas',
    addressRegion: 'Madrid',
    postalCode: '28100',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 40.5421482,
    longitude: -3.6332860,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],
      opens: '10:00',
      closes: '20:30',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de barbería',
    itemListElement: [
      {
        '@type': 'OfferCatalog',
        name: 'Corte',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Corte clásico',
              description: 'Corte de pelo con tijera o máquina, 30 minutos',
            },
            price: '13',
            priceCurrency: 'EUR',
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Corte degradado',
              description: 'Low, mid, high o skin fade, 40 minutos',
            },
            price: '13',
            priceCurrency: 'EUR',
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Corte y barba',
              description: 'Corte completo más arreglo de barba, 1 hora',
            },
            price: '18',
            priceCurrency: 'EUR',
          },
        ],
      },
      {
        '@type': 'OfferCatalog',
        name: 'Barba',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Barba clásica',
              description: 'Diseño, perfilado y navaja, 15 minutos',
            },
            price: '9',
            priceCurrency: 'EUR',
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Barba express',
              description: 'Arreglo rápido de barba, 5 minutos',
            },
            price: '4',
            priceCurrency: 'EUR',
          },
        ],
      },
      {
        '@type': 'OfferCatalog',
        name: 'Otros servicios',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Depilación cejas con cera',
              description: 'Depilación de cejas con cera, 15 minutos',
            },
            price: '8',
            priceCurrency: 'EUR',
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Depilación orejas y nariz',
              description: 'Depilación de orejas y nariz, 15 minutos',
            },
            price: '10',
            priceCurrency: 'EUR',
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Perfilado de cejas',
              description: 'Perfilado rápido de cejas, 5 minutos',
            },
            price: '2',
            priceCurrency: 'EUR',
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Lavado',
              description: 'Lavado de cabello, 5 minutos',
            },
            price: '2',
            priceCurrency: 'EUR',
          },
        ],
      },
    ],
  },
  hasMap: 'https://maps.app.goo.gl/h253SwzqPJnPNuEL6',
  areaServed: [
    { '@type': 'City', name: 'Alcobendas', sameAs: 'https://es.wikipedia.org/wiki/Alcobendas' },
    { '@type': 'City', name: 'San Sebastián de los Reyes' },
    { '@type': 'City', name: 'Tres Cantos' },
    { '@type': 'City', name: 'La Moraleja' },
    { '@type': 'City', name: 'Colmenar Viejo' },
  ],
  paymentAccepted: 'Efectivo, Tarjeta de crédito, Tarjeta de débito, Bizum',
  currenciesAccepted: 'EUR',
  sameAs: [
    'https://www.instagram.com/freshbarbershop_mad/',
    'https://booksy.com/es-es/127272_fresh-barber-shop-madrid_barberia_52925_alcobendas',
  ],
