---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const BOOKSY = 'https://booksy.com/es-es/127272_fresh-barber-shop-madrid_barberia_52925_alcobendas#ba_s=seo';

const dateFormatted = post.data.date.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const dateISO = post.data.date.toISOString().split('T')[0];
const SITE = 'https://fresh-barbershop.vercel.app';

const blogPostSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: dateISO,
  image: post.data.coverImage ? `${SITE}${post.data.coverImage}` : `${SITE}/images/hero-dani.jpeg`,
  author: {
    '@type': 'Organization',
    name: 'Fresh Barbershop',
    url: SITE,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Fresh Barbershop',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE}/images/logo-fresh-barbershop.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${SITE}/blog/${post.slug}`,
  },
};
---

<Layout
  title={`${post.data.title} — Fresh Barbershop`}
  description={post.data.excerpt}
  ogImage={post.data.coverImage ?? '/images/hero-dani.jpeg'}
  canonical={`/blog/${post.slug}`}
>

  <!-- BlogPosting JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(blogPostSchema)} />

  <!-- POST HERO ============================================ -->
  <div class="post-hero">
    <a class="post-back" href="/blog">← Blog</a>
    <p class="post-category">{post.data.category}</p>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-meta"><time datetime={dateISO}>{dateFormatted}</time> · Fresh Barbershop, Alcobendas</p>
  </div>

  <!-- COVER IMAGE (optional) =============================== -->
  {post.data.coverImage && (
    <img
      class="post-cover"
      src={post.data.coverImage}
      alt={post.data.title}
    />
  )}

  <!-- POST BODY ============================================ -->
  <article class="post-body">
    <Content />
  </article>

  <!-- HAIRLINE + CTA ======================================= -->
  <div style="max-width: 680px; margin: 0 auto; padding: 0 var(--gutter) var(--s80);">
    <div class="hairline" style="margin-bottom: var(--s48);"></div>
    <p style="font-size: var(--t-sm); color: var(--mid); margin-bottom: var(--s32); line-height: 1.6;">
      ¿Tienes dudas sobre tu próximo corte? En Fresh Barbershop te asesoramos en persona.
    </p>
    <a href={BOOKSY} target="_blank" rel="noopener nofollow" class="btn-ghost btn-ghost--dark" style="padding: 12px 28px; font-size: var(--t-sm);">
      Reservar cita en Booksy →
    </a>
  </div>

  <!-- MORE POSTS =========================================== -->
  <div class="booking booking--dark">
    <div class="booking-eyebrow">Seguir leyendo</div>
    <div class="booking-title">Más<br />del blog</div>
    <a href="/blog" class="btn-ghost btn-ghost--white btn-ghost--lg">
      Ver todos los artículos →
    </a>
  </div>

</Layout>
