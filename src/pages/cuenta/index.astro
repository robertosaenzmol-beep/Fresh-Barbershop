---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Mi cuenta — Fresh Barbershop" noindex={true}>
  <main class="auth-page">
    <!-- Loading state -->
    <div id="loading" class="auth-card" style="text-align:center;padding:var(--s48);">
      <p>Cargando...</p>
    </div>

    <!-- Profile content (hidden until auth check) -->
    <div id="profile" class="profile-container" hidden>
      <!-- User header -->
      <div class="profile-header">
        <div class="profile-avatar" id="profile-avatar">?</div>
        <div>
          <h1 class="profile-name" id="profile-name"></h1>
          <p class="profile-email" id="profile-email"></p>
        </div>
        <button class="profile-logout" id="logout-btn" aria-label="Cerrar sesión">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Salir
        </button>
      </div>

      <!-- Loyalty Card -->
      <div class="loyalty-card">
        <div class="loyalty-card-header">
          <svg class="loyalty-scissors" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
          <div>
            <h2 class="loyalty-card-title">Fresh Barbershop</h2>
            <p class="loyalty-card-subtitle">Tarjeta de Fidelización</p>
          </div>
        </div>

        <div class="stamp-grid" id="stamp-grid">
          <!-- Stamps rendered by JS -->
        </div>

        <div class="loyalty-progress">
          <span id="progress-text">0 de 10 visitas</span>
          <span id="progress-hint" class="loyalty-hint"></span>
        </div>

        <div class="loyalty-stats" id="loyalty-stats" hidden>
          <span id="cards-completed"></span>
        </div>

        <div class="loyalty-rules">
          <div class="loyalty-rule">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>La tarjeta caduca a los <strong>3 meses</strong> desde la primera visita</span>
          </div>
          <div class="loyalty-rule">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>El corte gratis solo se puede canjear de <strong>lunes a miércoles</strong></span>
          </div>
          <div class="loyalty-rule loyalty-rule--expiry" id="loyalty-expiry" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span id="expiry-text"></span>
          </div>
        </div>
      </div>

      <!-- QR Section -->
      <div class="qr-section">
        <button class="qr-generate-btn" id="generate-qr-btn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Generar QR para visita
        </button>
        <p class="qr-hint">Muestra el código QR al barbero para registrar tu visita</p>
      </div>

      <!-- Visit History -->
      <div class="history-section">
        <h2 class="history-title">Historial de visitas</h2>
        <div id="history-list" class="history-list">
          <p class="history-empty" id="history-empty">Aún no tienes visitas registradas</p>
        </div>
      </div>

      <!-- Data Management (RGPD) -->
      <div class="data-section">
        <h2 class="data-section-title">Mis datos personales</h2>
        <p class="data-section-desc">Gestiona tus datos según tus derechos reconocidos por el <strong>RGPD</strong> y la <strong>LOPD-GDD</strong>.</p>

        <button class="data-btn data-btn--download" id="download-data-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Descargar mis datos
        </button>

        <button class="data-btn data-btn--delete" id="delete-account-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          Eliminar mi cuenta y datos
        </button>

        <p class="data-section-legal">
          <a href="/politica-de-privacidad/">Política de privacidad</a> ·
          <a href="/aviso-legal/">Aviso legal</a> ·
          <a href="/politica-de-cookies/">Política de cookies</a>
        </p>
      </div>

      <!-- Aviso legal promoción -->
      <div class="promo-legal-notice">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <p>Fresh Barber Shop se reserva el derecho de modificar, suspender o cancelar el programa de fidelización y sus recompensas en cualquier momento, sin necesidad de previo aviso. Cada tarjeta tiene una validez máxima de 3 meses desde la fecha de la primera visita registrada; transcurrido dicho plazo, los sellos no canjeados se perderán. El corte gratuito de la décima visita únicamente podrá canjearse de lunes a miércoles. Los sellos acumulados no tienen valor monetario, no son canjeables por dinero y no son transferibles entre usuarios. La participación en el programa implica la aceptación de estas condiciones.</p>
      </div>

      <!-- Delete Account Modal -->
      <div class="qr-modal" id="delete-modal" hidden>
        <div class="qr-modal-content">
          <button class="qr-modal-close" id="delete-modal-close" aria-label="Cerrar">&times;</button>
          <div class="confirm-icon confirm-icon--error" style="margin:0 auto var(--s16);">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h2 class="qr-modal-title" style="color:var(--loyalty-red);">Eliminar cuenta</h2>
          <p class="qr-modal-desc">Esta acción es <strong>irreversible</strong>. Se eliminarán permanentemente:</p>
          <ul style="text-align:left;font-size:var(--t-sm);color:var(--mid);margin:var(--s12) 0;padding-left:var(--s20);">
            <li>Tu cuenta de usuario</li>
            <li>Tu historial de visitas</li>
            <li>Tus sellos y tarjetas completadas</li>
          </ul>
          <p class="qr-modal-desc">Escribe <strong>ELIMINAR</strong> para confirmar:</p>
          <input type="text" id="delete-confirm-input" class="auth-input" style="margin:var(--s12) 0;" placeholder="Escribe ELIMINAR" autocomplete="off" />
          <button class="auth-submit" id="delete-confirm-btn" style="background:var(--loyalty-red);width:100%;" disabled>
            Eliminar mi cuenta permanentemente
          </button>
        </div>
      </div>
    </div>

    <!-- QR Modal -->
    <div class="qr-modal" id="qr-modal" hidden>
      <div class="qr-modal-content">
        <button class="qr-modal-close" id="qr-modal-close" aria-label="Cerrar">&times;</button>
        <h2 class="qr-modal-title">Tu código QR</h2>
        <p class="qr-modal-desc">Muéstrale este código al barbero</p>
        <canvas id="qr-canvas"></canvas>
        <p class="qr-modal-expire">Este código es de un solo uso</p>
      </div>
    </div>
  </main>
</Layout>

<script>
  import QRCode from 'qrcode';
  import { auth, db } from '../../lib/firebase';
  import { onAuthStateChanged, signOut, deleteUser } from 'firebase/auth';
  import {
    collection, addDoc, getDocs, getDoc, doc, query, where, orderBy, serverTimestamp, Timestamp,
    deleteDoc
  } from 'firebase/firestore';

  const SITE = 'https://freshbarbershop.es'; // dominio fijo: la sesión de la barbería solo vale en este

  const loadingEl = document.getElementById('loading')!;
  const profileEl = document.getElementById('profile')!;

  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      window.location.href = '/cuenta/login/';
      return;
    }

    try {
    loadingEl.hidden = true;
    profileEl.hidden = false;

    const userDocSnap = await getDoc(doc(db, 'users', user.uid));
    const userData = userDocSnap.data();
    const userName = userData?.name || user.email?.split('@')[0] || 'Usuario';

    document.getElementById('profile-name')!.textContent = userName;
    document.getElementById('profile-email')!.textContent = user.email || '';
    document.getElementById('profile-avatar')!.textContent = userName.charAt(0).toUpperCase();

    const visitsQuery = query(
      collection(db, 'visits'),
      where('userId', '==', user.uid)
    );
    const visitsSnap = await getDocs(visitsQuery);
    // Sort client-side to avoid needing a composite index
    const visitDocs = visitsSnap.docs.sort((a, b) => {
      const ta = a.data().timestamp?.toMillis?.() || 0;
      const tb = b.data().timestamp?.toMillis?.() || 0;
      return tb - ta;
    });
    const totalVisits = visitDocs.length;
    const currentStamps = totalVisits % 10;
    const cardsCompleted = Math.floor(totalVisits / 10);

    renderStamps(currentStamps);

    document.getElementById('progress-text')!.textContent = `${currentStamps} de 10 visitas`;

    const hintEl = document.getElementById('progress-hint')!;
    if (currentStamps === 9) {
      hintEl.textContent = '¡Tu próximo corte es GRATIS!';
      hintEl.classList.add('loyalty-hint--alert');
    } else if (currentStamps === 4) {
      hintEl.textContent = '¡Tu próxima visita tiene un 10% de descuento!';
      hintEl.classList.add('loyalty-hint--alert');
    } else if (currentStamps === 0 && totalVisits > 0) {
      hintEl.textContent = '¡Tarjeta nueva! Sigue acumulando visitas';
    } else {
      hintEl.textContent = `Te faltan ${10 - currentStamps} visitas para tu corte gratis`;
    }

    // Card expiry: 3 months from first visit of current card
    if (currentStamps > 0) {
      // visitDocs sorted newest-first; current card starts at index (currentStamps - 1) from newest
      const cardStartIdx = currentStamps - 1;
      const firstVisitOfCard = visitDocs[cardStartIdx]?.data();
      if (firstVisitOfCard?.timestamp) {
        const startDate = firstVisitOfCard.timestamp instanceof Timestamp
          ? firstVisitOfCard.timestamp.toDate()
          : new Date(firstVisitOfCard.timestamp);
        const expiryDate = new Date(startDate);
        expiryDate.setMonth(expiryDate.getMonth() + 3);
        const now = new Date();
        const daysLeft = Math.ceil((expiryDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
        const expiryEl = document.getElementById('loyalty-expiry')!;
        const expiryText = document.getElementById('expiry-text')!;
        expiryEl.hidden = false;
        if (daysLeft <= 0) {
          expiryText.innerHTML = '<strong>Tu tarjeta ha caducado.</strong> Los sellos se han perdido.';
          expiryEl.classList.add('loyalty-rule--expired');
        } else if (daysLeft <= 14) {
          expiryText.innerHTML = `Tu tarjeta caduca en <strong>${daysLeft} día${daysLeft !== 1 ? 's' : ''}</strong>. ¡Date prisa!`;
          expiryEl.classList.add('loyalty-rule--urgent');
        } else {
          const expStr = expiryDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
          expiryText.innerHTML = `Tu tarjeta caduca el <strong>${expStr}</strong>`;
        }
      }
    }

    if (cardsCompleted > 0) {
      const statsEl = document.getElementById('loyalty-stats')!;
      statsEl.hidden = false;
      document.getElementById('cards-completed')!.textContent =
        `${cardsCompleted} corte${cardsCompleted > 1 ? 's' : ''} gratis canjeado${cardsCompleted > 1 ? 's' : ''}`;
    }

    const historyList = document.getElementById('history-list')!;
    const historyEmpty = document.getElementById('history-empty')!;

    if (totalVisits > 0) {
      historyEmpty.hidden = true;
      visitDocs.forEach((visitDoc) => {
        const visit = visitDoc.data();
        const date = visit.timestamp instanceof Timestamp
          ? visit.timestamp.toDate()
          : new Date();
        const visitNum = visit.visitNumber || '—';
        const isFree = visit.isFreecut === true;

        const item = document.createElement('div');
        item.className = 'history-item' + (isFree ? ' history-item--free' : '');
        item.innerHTML = `
          <div class="history-item-info">
            <span class="history-item-date">${date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            <span class="history-item-num">Visita ${visitNum}/10</span>
          </div>
          ${isFree ? '<span class="history-item-badge">GRATIS</span>' : ''}
        `;
        historyList.appendChild(item);
      });
    }

    document.getElementById('generate-qr-btn')!.addEventListener('click', async () => {
      const btn = document.getElementById('generate-qr-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Generando...';

      try {
        const tokenDoc = await addDoc(collection(db, 'visitTokens'), {
          userId: user.uid,
          userName,
          userEmail: user.email,
          currentVisits: totalVisits,
          createdAt: serverTimestamp(),
          used: false,
        });

        const url = `${SITE}/confirmar-visita/?token=${tokenDoc.id}`;
        const canvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
        await QRCode.toCanvas(canvas, url, {
          width: 260,
          margin: 2,
          color: { dark: '#1e3a5f', light: '#ffffff' },
        });

        document.getElementById('qr-modal')!.hidden = false;
      } catch (err) {
        alert('Error al generar el QR. Inténtalo de nuevo.');
      }

      btn.disabled = false;
      btn.innerHTML = `
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Generar QR para visita
      `;
    });

    document.getElementById('qr-modal-close')!.addEventListener('click', () => {
      document.getElementById('qr-modal')!.hidden = true;
    });

    document.getElementById('qr-modal')!.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) {
        document.getElementById('qr-modal')!.hidden = true;
      }
    });

    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      await signOut(auth);
      window.location.href = '/';
    });

    // Download data (RGPD portability)
    document.getElementById('download-data-btn')!.addEventListener('click', async () => {
      const btn = document.getElementById('download-data-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Preparando...';

      const exportData: Record<string, any> = {
        exportDate: new Date().toISOString(),
        user: {
          name: userName,
          email: user.email,
          uid: user.uid,
          accountCreated: userData?.createdAt?.toDate?.()?.toISOString() || 'No disponible',
          privacyConsentAt: userData?.privacyConsentAt?.toDate?.()?.toISOString() || 'No disponible',
        },
        loyaltyCard: {
          totalVisits,
          currentStamps,
          cardsCompleted,
        },
        visits: [] as any[],
      };

      visitDocs.forEach((visitDoc) => {
        const v = visitDoc.data();
        exportData.visits.push({
          visitNumber: v.visitNumber,
          isFreecut: v.isFreecut || false,
          date: v.timestamp instanceof Timestamp ? v.timestamp.toDate().toISOString() : 'No disponible',
        });
      });

      const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `fresh-barbershop-mis-datos-${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);

      btn.disabled = false;
      btn.innerHTML = `
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Descargar mis datos
      `;
    });

    // Delete account (RGPD erasure)
    const deleteModal = document.getElementById('delete-modal')!;
    const deleteInput = document.getElementById('delete-confirm-input') as HTMLInputElement;
    const deleteBtn = document.getElementById('delete-confirm-btn') as HTMLButtonElement;

    document.getElementById('delete-account-btn')!.addEventListener('click', () => {
      deleteModal.hidden = false;
      deleteInput.value = '';
      deleteBtn.disabled = true;
    });

    document.getElementById('delete-modal-close')!.addEventListener('click', () => {
      deleteModal.hidden = true;
    });

    deleteModal.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) deleteModal.hidden = true;
    });

    deleteInput.addEventListener('input', () => {
      deleteBtn.disabled = deleteInput.value.trim() !== 'ELIMINAR';
    });

    deleteBtn.addEventListener('click', async () => {
      if (deleteInput.value.trim() !== 'ELIMINAR') return;

      deleteBtn.disabled = true;
      deleteBtn.textContent = 'Eliminando...';

      try {
        // Delete visits
        const userVisits = await getDocs(query(collection(db, 'visits'), where('userId', '==', user.uid)));
        for (const visitDoc of userVisits.docs) {
          await deleteDoc(visitDoc.ref);
        }

        // Delete visit tokens
        const userTokens = await getDocs(query(collection(db, 'visitTokens'), where('userId', '==', user.uid)));
        for (const tokenDoc of userTokens.docs) {
          await deleteDoc(tokenDoc.ref);
        }

        // Delete user document
        await deleteDoc(doc(db, 'users', user.uid));

        // Delete Firebase Auth account
        await deleteUser(user);

        window.location.href = '/?account_deleted=1';
      } catch (err: any) {
        if (err.code === 'auth/requires-recent-login') {
          alert('Por seguridad, necesitas cerrar sesión, volver a iniciar sesión y repetir la eliminación.');
        } else {
          alert('Error al eliminar la cuenta. Inténtalo de nuevo o contacta con freshbarbershop15@gmail.com');
        }
        deleteBtn.disabled = false;
        deleteBtn.textContent = 'Eliminar mi cuenta permanentemente';
      }
    });

    } catch (err) {
      console.error('Error loading profile:', err);
      loadingEl.innerHTML = '<p>Error al cargar el perfil. <a href="/cuenta/">Reintentar</a></p>';
    }
  });

  function renderStamps(filled: number) {
    const grid = document.getElementById('stamp-grid')!;
    grid.innerHTML = '';

    for (let i = 1; i <= 10; i++) {
      const stamp = document.createElement('div');
      const isLast = i === 10;
      const isDiscount = i === 5;
      const isDone = i <= filled;

      stamp.className = 'stamp'
        + (isDone ? ' stamp--done' : '')
        + (isLast ? ' stamp--free' : '')
        + (isDiscount ? ' stamp--discount' : '');

      if (isLast) {
        stamp.innerHTML = isDone
          ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>'
          : '<span class="stamp-free-label">GRATIS</span>';
      } else if (isDiscount) {
        stamp.innerHTML = isDone
          ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>'
          : '<span class="stamp-discount-label">-10%</span>';
      } else {
        stamp.innerHTML = isDone
          ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>'
          : `<span class="stamp-num">${i}</span>`;
      }

      grid.appendChild(stamp);
    }
  }
</script>
