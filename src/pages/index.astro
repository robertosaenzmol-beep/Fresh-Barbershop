---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const BOOKSY = 'https://booksy.com/es-es/127272_fresh-barber-shop-madrid_barberia_52925_alcobendas#ba_s=seo';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const reviews = [
  { name: 'Fran Sevilla',       date: 'Google',  text: 'Una barbería excelente, con grandes profesionales que siempre se adaptan a tus gustos y cortes. El trato es muy bueno. El local es muy amplio y luminoso.' },
  { name: 'Fernando Cerezo',    date: 'Google',  text: 'Barbería de 10, grande, limpia, elegante y el trato lo mejor. Miguel un crack. Super recomendable.' },
  { name: 'Patricia Paredes',   date: 'Google',  text: 'Gracias a Simón por su excelente atención y paciencia. Recomiendo al 1000%.' },
  { name: 'Viviana Palomino',   date: 'Google',  text: 'El mejor con la paciencia para los niños. El lugar es acogedor y agradable. Recomendado.' },
  { name: 'Pablo Ramos',        date: 'Google',  text: 'Yo me corto con Antonio y es un profesional. El trato es muy cercano. Recomendable 100%.' },
  { name: 'Carlos Alberto',     date: 'Google',  text: 'Buen servicio y atención, condiciones del local excelentes. Gracias a Ricardo. Volveremos pronto.' },
  { name: 'Daniel Martín',      date: 'Google',  text: 'Llevo yendo más de un año y siempre salgo contento. El ambiente es muy bueno y los chicos son unos profesionales.' },
  { name: 'Raúl G.',            date: 'Google',  text: 'Muy buen trato, te escuchan y te asesoran. No es una barbería de corte rápido, aquí se nota que les importa el resultado.' },
  { name: 'Javier López',       date: 'Google',  text: 'Fui por primera vez y repetiré seguro. Me hicieron un degradado perfecto. El local es espectacular, muy limpio y moderno.' },
  { name: 'Sergio M.',          date: 'Google',  text: 'Simón es un crack. Me cortó el pelo y la barba y quedó genial. El sitio es muy cómodo y tienen buen rollo.' },
  { name: 'Alejandro Ruiz',     date: 'Google',  text: 'La mejor barbería de la zona sin duda. Profesionalidad, limpieza y un trato inmejorable. 100% recomendable.' },
  { name: 'Marco A.',           date: 'Google',  text: 'Siempre que voy salgo con el corte perfecto. El equipo es muy profesional y el ambiente genial. Recomendadísimo.' },
];
---

<Layout preloadImage="/images/hero-dani.webp">

  <!-- HERO ================================================= -->
  <section class="hero">
    <div class="hero-bg">
      <img
        src="/images/hero-dani.webp"
        alt="Fresh Barbershop Madrid"
        loading="eager"
        fetchpriority="high"
        width="1400"
        height="1400"
      />
    </div>

    <div class="hero-content">
      <p class="hero-eyebrow">Alcobendas · Madrid</p>

      <img
        class="hero-logo-mark"
        src="/images/logo-fresh-barbershop.webp"
        alt="Fresh Barbershop"
        width="800"
        height="451"
      />

      <div class="hero-bottom">
        <h1 class="hero-desc">
          Barbería en Alcobendas.<br />
          Degradados, cortes y barba hechos<br />con tiempo, con criterio y con ganas.
        </h1>
        <div class="hero-cta-wrap">
          <a href={BOOKSY} target="_blank" rel="noopener nofollow" class="btn-ghost btn-ghost--white btn-ghost--lg" onclick="gtag('event', 'reserva_booksy', { 'metodo': 'boton_web' })">
            Pedir cita →
          </a>
        </div>
      </div>
    </div>

    <div class="hero-scroll">
      <div class="hero-scroll-line"></div>
      <span class="hero-scroll-label">Scroll</span>
    </div>
  </section>


  <!-- PROPUESTA DE VALOR ==================================== -->
  <section class="valor section section--dark">
    <div class="valor-layout reveal-group">
      <div class="valor-left">
        <div class="valor-eyebrow">Barbería en Alcobendas</div>
        <h2 class="valor-headline">Vienes una vez,<br />vuelves siempre.</h2>
        <p class="valor-text">
          Aquí no hay prisas ni cortes de cadena. Cada degradado tiene su proceso, cada barba su tiempo. Sabemos lo que hacemos y se nota.
        </p>
        <a href={BOOKSY} target="_blank" rel="noopener nofollow" class="btn-ghost btn-ghost--white btn-ghost--lg" onclick="gtag('event', 'reserva_booksy', { 'metodo': 'boton_web' })">
          Reservar cita →
        </a>
      </div>
      <div class="valor-right">
        <div class="about-model">
          <model-viewer
            src="/images/animacionTijera.glb"
            alt="Tijeras de barbería 3D"
            auto-rotate
            auto-rotate-delay="0"
            rotation-per-second="20deg"
            interaction-prompt="none"
            shadow-intensity="0"
            exposure="1.2"
            environment-image="neutral"
            style="width:100%;height:100%;background:transparent;"
          ></model-viewer>
        </div>
      </div>
    </div>

    <div class="valor-pillars reveal-group">
      <div class="pillar">
        <div class="pillar-num">01</div>
        <div class="pillar-title">Sin prisa</div>
        <div class="pillar-desc">Nos tomamos el tiempo que hace falta. Cada degradado tiene su proceso y no lo cortamos.</div>
      </div>
      <div class="pillar">
        <div class="pillar-num">02</div>
        <div class="pillar-title">Criterio</div>
        <div class="pillar-desc">Escuchamos lo que quieres y aportamos lo que sabemos. El resultado es lo mejor de los dos.</div>
      </div>
      <div class="pillar">
        <div class="pillar-num">03</div>
        <div class="pillar-title">Tu sitio</div>
        <div class="pillar-desc">Llevamos años en Alcobendas. No somos una franquicia ni un pop-up. Estamos aquí.</div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      var loaded = false;
      var target = document.querySelector('.about-model');
      if (!target) return;
      var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting && !loaded) {
          loaded = true;
          var s = document.createElement('script');
          s.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js';
          s.type = 'module';
          document.head.appendChild(s);
          observer.disconnect();
        }
      }, { rootMargin: '50px' });
      observer.observe(target);
    })();
  </script>


  <!-- FOTOS: Sillones + Interior luces + Sala de espera -->
  <div class="photo-accent-trio reveal-group">
    <div class="photo-accent photo-accent--cell">
      <img src="/images/sillones.webp" alt="Sillones de barbería con capas Fresh Barbershop Alcobendas" loading="lazy" width="959" height="1280" />
    </div>
    <div class="photo-accent photo-accent--cell">
      <img src="/images/interior-luces.webp" alt="Interior con luces hexagonales Fresh Barbershop Alcobendas" loading="lazy" width="960" height="1280" style="object-position: center 30%;" />
    </div>
    <div class="photo-accent photo-accent--cell">
      <img src="/images/sala-espera.webp" alt="Sala de espera Fresh Barbershop Alcobendas" loading="lazy" width="960" height="1280" />
    </div>
  </div>


  <!-- MAPA ================================================= -->
  <section class="map-section">
    <div class="map-label reveal">Ubicación · Alcobendas, Madrid</div>
    <div class="map-wrapper reveal">
      <iframe
        data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6063.949386671603!2d-3.6332860238589633!3d40.54214824799619!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd422dd4637e250d%3A0x2cf62e2df3f9a51b!2sFresh%20barber%20shop%20Madrid%20Barber%C3%ADa%26peluqueria%20masculina!5e0!3m2!1ses!2ses!4v1787755596528!5m2!1ses!2ses"
        width="600"
        height="450"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title="Fresh Barbershop en Google Maps"
        style="border:0;"
        id="map-iframe"
      ></iframe>
    </div>
    <div class="map-address reveal">
      <span>C. de la Marquesa Viuda de Aldama, 40</span>
      <span>28100 Alcobendas, Madrid</span>
      <a href="https://maps.app.goo.gl/h253SwzqPJnPNuEL6" target="_blank" rel="noopener nofollow" class="map-directions" onclick="gtag('event', 'como_llegar', { 'metodo': 'mapa' })">Cómo llegar ↗</a>
    </div>
  </section>


  <script is:inline>
    (function() {
      var iframe = document.getElementById('map-iframe');
      if (!iframe) return;
      var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          iframe.src = iframe.getAttribute('data-src');
          observer.disconnect();
        }
      }, { rootMargin: '300px' });
      observer.observe(iframe);
    })();
  </script>

  <!-- RESEÑAS ============================================== -->
  <section class="section section--paper reviews-section">
    <div class="reviews-header reveal">
      <div class="reviews-intro-text">
        <div class="wordmark wordmark--header">Reseñas</div>
        <p class="reviews-tagline">Somos buenos y la gente lo sabe.</p>
      </div>
      <div class="reviews-badges">
        <div class="reviews-badge">
          <span class="reviews-badge-source">Google</span>
          <div class="reviews-badge-rating">
            <span class="reviews-badge-score">4.9</span>
            <span class="reviews-badge-stars">★★★★★</span>
          </div>
          <span class="reviews-badge-count">51 reseñas</span>
        </div>
        <div class="reviews-badge">
          <span class="reviews-badge-source">Booksy</span>
          <div class="reviews-badge-rating">
            <span class="reviews-badge-score">5.0</span>
            <span class="reviews-badge-stars">★★★★★</span>
          </div>
          <span class="reviews-badge-count">258 reseñas</span>
        </div>
      </div>
    </div>

    <div class="carousel reveal" id="reviews-carousel">
      <div class="carousel-track" id="reviews-track">
        {reviews.map(r => (
          <div class="review-card">
            <div class="review-card-stars">★★★★★</div>
            <p class="review-text">{r.text}</p>
            <div class="review-footer">
              <span class="review-name">{r.name}</span>
              <span class="review-source">{r.date}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="carousel-controls">
        <button class="carousel-btn carousel-btn--prev" id="reviews-prev" aria-label="Anterior">←</button>
        <button class="carousel-btn carousel-btn--next" id="reviews-next" aria-label="Siguiente">→</button>
      </div>
    </div>

    <div class="reveal" style="margin-top: var(--s48);">
      <a
        href="https://maps.app.goo.gl/h253SwzqPJnPNuEL6"
        target="_blank"
        rel="noopener nofollow"
        class="btn-ghost btn-ghost--dark"
        style="padding: 12px 28px; font-size: var(--t-sm);"
      >
        Ver todas en Google →
      </a>
    </div>
  </section>

  <!-- SERVICES ============================================= -->
  <section class="section">
    <div class="wordmark reveal">Servicios</div>

    <!-- CORTE + BARBA -->
    <div class="services-block reveal-group">
      <div class="services-block-header">
        <span class="services-block-label">Corte</span>
        <span class="services-block-label">Barba</span>
      </div>
      <div class="services-cols">
        <div class="services-col">
          <div class="services-col-label">Corte</div>
          <div class="service-row">
            <div>
              <div class="service-name">Corte clásico</div>
              <div class="service-note">30 min · tijera o máquina</div>
            </div>
            <div class="service-price">13 €</div>
          </div>
          <div class="service-row">
            <div>
              <div class="service-name">Corte degradado</div>
              <div class="service-note">40 min · low, mid, high o skin fade</div>
            </div>
            <div class="service-price">13 €</div>
          </div>
          <div class="service-row service-row--last">
            <div>
              <div class="service-name">Corte &amp; Barba</div>
              <div class="service-note">1 h · los dos, bien hechos</div>
            </div>
            <div class="service-price">18 €</div>
          </div>
        </div>

        <div class="services-divider"></div>

        <div class="services-col">
          <div class="services-col-label">Barba</div>
          <div class="service-row">
            <div>
              <div class="service-name">Barba clásica</div>
              <div class="service-note">15 min · diseño, perfilado y navaja</div>
            </div>
            <div class="service-price">9 €</div>
          </div>
          <div class="service-row service-row--last">
            <div>
              <div class="service-name">Barba express</div>
              <div class="service-note">5 min · arreglo rápido</div>
            </div>
            <div class="service-price">4 €</div>
          </div>
        </div>
      </div>
    </div>

    <!-- OTROS SERVICIOS -->
    <div class="services-block services-block--secondary reveal-group">
      <div class="services-block-header">
        <span class="services-block-label">Más servicios</span>
      </div>
      <div class="services-grid">
        <div class="service-row">
          <div>
            <div class="service-name">Depilación cejas con cera</div>
            <div class="service-note">15 min</div>
          </div>
          <div class="service-price">8 €</div>
        </div>
        <div class="service-row">
          <div>
            <div class="service-name">Depilación orejas y nariz</div>
            <div class="service-note">15 min</div>
          </div>
          <div class="service-price">10 €</div>
        </div>
        <div class="service-row service-row--last">
          <div>
            <div class="service-name">Perfilado de cejas</div>
            <div class="service-note">5 min</div>
          </div>
          <div class="service-price">2 €</div>
        </div>
        <div class="service-row service-row--last">
          <div>
            <div class="service-name">Lavado</div>
            <div class="service-note">5 min</div>
          </div>
          <div class="service-price">2 €</div>
        </div>
        <div class="service-row service-row--last">
          <div>
            <div class="service-name">Ondulación permanente</div>
            <div class="service-note">2 h 30 min · precio según consulta</div>
          </div>
          <div class="service-price">Consultar</div>
        </div>
      </div>
    </div>
  </section>


  <!-- FOTO: Herramientas + Tarjeta -->
  <div class="photo-accent-duo reveal-group">
    <div class="photo-accent photo-accent--half">
      <img src="/images/herramientas.webp" alt="Herramientas de barbería profesional Fresh Barbershop" loading="lazy" width="960" height="1280" />
    </div>
    <div class="photo-accent photo-accent--half">
      <img src="/images/tarjeta-fresh.webp" alt="Tarjeta de visita Fresh Barber Shop Madrid" loading="lazy" width="960" height="1280" />
    </div>
  </div>

  <!-- BLOG ================================================= -->
  <section class="section section--paper">
    <div class="wordmark reveal">Blog</div>
    <div class="reveal" style="font-size: var(--t-sm); color: var(--mid); margin-top: var(--s32); margin-bottom: var(--s48); max-width: 480px; line-height: 1.6;">
      Lo que sabemos, lo compartimos. Guías de barbería escritas desde la silla, no desde un blog de contenido genérico.
    </div>

    <div class="blog-list reveal-group">
      {posts.map((post, i) => (
        <a class="blog-item" href={`/blog/${post.id}`}>
          <div class="blog-num">{String(i + 1).padStart(2, '0')}</div>
          <div class="blog-body">
            <div class="blog-category">{post.data.category}</div>
            <div class="blog-title">{post.data.title}</div>
            <div class="blog-excerpt">{post.data.excerpt}</div>
          </div>
          <div class="blog-meta">
            <span class="blog-date">
              {post.data.date.toLocaleDateString('es-ES', { month: 'short', year: 'numeric' })}
            </span>
            <span class="blog-arrow">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>


  <!-- CONTACTO ============================================= -->
  <section class="section">
    <div class="wordmark reveal">Contacto</div>
    <div class="info-grid">

      <div class="info-col">
        <div class="info-label">Cuándo venimos</div>
        <div class="hour-row">
          <span class="hour-day">Lunes – Sábado</span>
          <span class="hour-time">10:00 – 20:30</span>
        </div>
        <div class="hour-row">
          <span class="hour-day">Domingo</span>
          <span class="hour-time hour-time--closed">Cerrado</span>
        </div>
        <div style="margin-top: var(--s40);">
          <a href={BOOKSY} target="_blank" rel="noopener nofollow" class="btn-ghost btn-ghost--dark" style="padding: 12px 24px; font-size: var(--t-sm);" onclick="gtag('event', 'reserva_booksy', { 'metodo': 'boton_web' })">
            Reservar en Booksy →
          </a>
        </div>
      </div>

      <div class="info-col">
        <div class="info-label">Dónde estamos</div>
        <a href="https://share.google/6tSTJGZo5cR8UOMvf" target="_blank" rel="noopener nofollow" class="contact-address" style="display:block; text-decoration:none;" onclick="gtag('event', 'como_llegar', { 'metodo': 'contacto' })">
          C. de la Marquesa<br />Viuda de Aldama, 40<br />28100 Alcobendas, Madrid ↗
        </a>
        <div class="contact-rows">
          <div class="contact-row">
            <span class="contact-row-label">Teléfono</span>
            <span class="contact-row-value"><a href="tel:+34642701740" onclick="gtag('event', 'llamada_telefono', { 'metodo': 'contacto' })">642 70 17 40</a></span>
          </div>
          <div class="contact-row">
            <span class="contact-row-label">Instagram</span>
            <span class="contact-row-value">
              <a href="https://www.instagram.com/freshbarbershop_mad/" target="_blank" rel="noopener nofollow">@freshbarbershop_mad</a>
            </span>
          </div>
          <div class="contact-row">
            <span class="contact-row-label">Simón</span>
            <span class="contact-row-value">
              <a href="https://www.instagram.com/saimonguedez_19" target="_blank" rel="noopener nofollow">@saimonguedez_19</a>
            </span>
          </div>
          <div class="contact-row">
            <span class="contact-row-label">Email</span>
            <span class="contact-row-value">
              <a href="mailto:freshbarbershop15@gmail.com">freshbarbershop15@gmail.com</a>
            </span>
          </div>
          <div class="contact-row">
            <span class="contact-row-label">Reservas</span>
            <span class="contact-row-value">
              <a href={BOOKSY} target="_blank" rel="noopener nofollow" onclick="gtag('event', 'reserva_booksy', { 'metodo': 'boton_web' })">Booksy</a>
            </span>
          </div>
        </div>
      </div>

    </div>
  </section>


  <!-- FOTO: Lavacabezas -->
  <div class="photo-accent reveal">
    <img src="/images/lavacabezas.webp" alt="Lavacabezas profesionales Fresh Barbershop Alcobendas" loading="lazy" width="960" height="1280" />
  </div>

  <!-- BOOKING CTA ========================================== -->
  <div class="booking">
    <div class="booking-eyebrow reveal">Ya sabes que toca</div>
    <div class="booking-title reveal">Pide<br />tu cita</div>
    <div class="booking-sub reveal">Alcobendas · Madrid · 642 70 17 40</div>
    <a href={BOOKSY} target="_blank" rel="noopener nofollow" class="btn-ghost btn-ghost--white btn-ghost--lg" onclick="gtag('event', 'reserva_booksy', { 'metodo': 'boton_web' })">
      Pedir cita en Booksy →
    </a>
  </div>

  <!-- Reviews carousel script -->
  <script is:inline>
    (function () {
      var track = document.getElementById('reviews-track');
      var prev = document.getElementById('reviews-prev');
      var next = document.getElementById('reviews-next');
      if (!track || !prev || !next) return;

      function getCardWidth() {
        var card = track.querySelector('.review-card');
        if (!card) return 320;
        var style = getComputedStyle(track);
        var gap = parseFloat(style.gap) || 24;
        return card.offsetWidth + gap;
      }

      prev.addEventListener('click', function () {
        track.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
      });
      next.addEventListener('click', function () {
        track.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
      });
    })();
  </script>

</Layout>
